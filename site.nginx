server {
    listen 80;
    listen [::]:80;
    server_name formulix.baptistemiramont.fr;
    
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
        try_files $uri =404;
    }
    
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name formulix.baptistemiramont.fr;

    ssl_certificate /etc/letsencrypt/live/formulix.baptistemiramont.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/formulix.baptistemiramont.fr/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
        try_files $uri =404;
    }

    root /home/ubuntu/formulix-app;
    index index.html;

    location / {
        try_files $uri /index.html;
    }

    error_log /var/log/nginx/formulix.baptistemiramont.fr-error.log;
    access_log /var/log/nginx/formulix.baptistemiramont.fr-access.log;
}
